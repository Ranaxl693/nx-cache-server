{
  "name": "nx-self-hosted-cache-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.14.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "dev": "npm run build && npm start",
    "test": "vitest run",
    "test:nx": "node scripts/nx-integration.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit": "npm audit --omit=dev"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^9.39.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^5.0.5"
  }
}
